#!/usr/bin/env bash
set -euo pipefail
out=""
file=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --output-file)
      out="$2"
      shift 2
      ;;
    --format|--no-error-on-unmatched-pattern)
      if [ "$1" = "--format" ]; then
        shift 2
      else
        shift 1
      fi
      ;;
    *)
      file="$1"
      shift 1
      ;;
  esac
done
if [ -z "$out" ]; then
  echo "missing --output-file" >&2
  exit 2
fi
cat > "$out" <<JSON
[
  {
    "filePath": "$file",
    "messages": [
      {
        "ruleId": "semi",
        "severity": 1,
        "message": "Missing semicolon.",
        "line": 2,
        "column": 15,
        "endLine": 2,
        "endColumn": 16
      }
    ]
  }
]
JSON
exit 0
