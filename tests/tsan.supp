# TSan suppressions for microide_tests.
# Lock-order-inversion warnings inside libdbus's internal mutexes are reported
# when SDL initializes/teardowns dbus integration across threads. The locking
# is internal to libdbus (not microide code), so we suppress the warning here
# rather than leaving a flake in the sanitizer matrix.
deadlock:libdbus-1

# Data races reported inside the Mesa userspace GPU driver (libgallium) when the
# ApplicationTests drive real GPU rendering across SDL's render threads. The
# races are internal to the driver (not microide code) and only surface on hosts
# with hardware/software GL acceleration; suppress them like the libdbus case
# rather than leaving environment-dependent flakes in the sanitizer matrix.
race:libgallium

# The LSP/DAP shutdown send path (now the shared
# StdioJsonRpcClientTransport::SendMessageImmediate) used to need a mutex
# suppression here: it acquired write_mutex via std::timed_mutex::try_lock_for,
# which GCC 13's libtsan does not intercept (pthread_mutex_timedlock), yielding a
# spurious "unlock of an unlocked mutex". The code switched to a plain std::mutex
# with a try_lock poll — which TSan models correctly — so the suppression is gone.
# If that report ever reappears, scope any new entry to the shared function, not
# a blanket mutex: line.
