# TSan suppressions for microide_tests.
# Lock-order-inversion warnings inside libdbus's internal mutexes are reported
# when SDL initializes/teardowns dbus integration across threads. The locking
# is internal to libdbus (not microide code), so we suppress the warning here
# rather than leaving a flake in the sanitizer matrix.
deadlock:libdbus-1

# Data races reported inside the Mesa userspace GPU driver (libgallium) when the
# ApplicationTests drive real GPU rendering across SDL's render threads. The
# races are internal to the driver (not microide code) and only surface on hosts
# with hardware/software GL acceleration; suppress them like the libdbus case
# rather than leaving environment-dependent flakes in the sanitizer matrix.
race:libgallium

# False-positive "unlock of an unlocked mutex (or by a wrong thread)" on the LSP
# shutdown send path. GCC 13's libtsan does not intercept pthread_mutex_timedlock
# (the mechanism behind std::timed_mutex::try_lock_for), so a *successful* timed
# acquisition is never recorded and the subsequent correct same-thread unlock is
# misreported. Confirmed with a minimal single-threaded try_lock_for repro under
# this exact toolchain (g++ 13.3, libtsan.so.2). The bounded write_mutex acquire
# in SendMessageImmediate is correct — it early-returns without unlocking when the
# timed lock is not acquired and only ever unlocks on the acquiring thread. Scope
# the suppression to that one function so genuine races elsewhere still surface.
mutex:microide::workspace::LspClient::Impl::SendMessageImmediate
