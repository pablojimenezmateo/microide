/build/
/build-*/
/_CPack_Packages/
/*.deb
# Generated release-artifact siblings of the .deb (detached signatures + checksums).
# These are uploaded to the GitHub release, not committed; the tracked public key
# (microide-signing-key.asc) is intentionally NOT matched by these patterns.
/microide_*_amd64.deb.asc
/microide_*_amd64.deb.sha256
/microide_*_amd64.deb.sha256.asc
/.microide-config
/.microide-session
/.codex
/.idea/
/.vscode/
*.swp
*.swo
*~

# OS / editor / tooling cruft and Python bytecode (generators run via python3).
.DS_Store
__pycache__/
*.pyc
*.orig

# libFuzzer corpora accumulate auto-generated, hash-named inputs on every run and
# clog the tree. Ignore those, but keep each target's directory (a tracked
# .gitkeep) so the documented `./<Target>Fuzz tests/fuzz/corpora/<Target>`
# commands still work (libFuzzer errors on a missing corpus dir), and keep any
# hand-curated `seed_*` inputs (intentional, not regenerated identically).
/tests/fuzz/corpora/*/*
!/tests/fuzz/corpora/*/.gitkeep
!/tests/fuzz/corpora/*/seed_*

# Nix build artifacts (the `nix build` / `nix flake check` output symlink).
/result
/result-*

# clangd index (created whenever compile_commands.json is exported).
/.cache/

# Coverage lane artifacts (tools/run-checks.sh coverage)
build/microide-coverage/
