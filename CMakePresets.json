{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "microide-perf",
      "displayName": "microide perf harness",
      "description": "Release-style build with perf harness instrumentation enabled.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/microide-perf-make",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MICROIDE_WARNINGS_AS_ERRORS": "OFF",
        "MICROIDE_PERF_HARNESS_BUILD": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "microide-perf-trace",
      "displayName": "microide perf harness (trace-safe symbols)",
      "description": "The perf lane with identical-code folding off, so allocation-trace symbol names are trustworthy (TD-2026-08-13-197). Not for recording baselines: ICF is real codegen and the committed numbers were taken under it.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/microide-perf-trace",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MICROIDE_WARNINGS_AS_ERRORS": "OFF",
        "MICROIDE_PERF_HARNESS_BUILD": "ON",
        "MICROIDE_PERF_TRACE_SYMBOLS": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "microide-asan",
      "displayName": "microide address sanitizer",
      "description": "Debug build with AddressSanitizer enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/microide-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICROIDE_WARNINGS_AS_ERRORS": "OFF",
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "microide-ubsan",
      "displayName": "microide undefined behavior sanitizer",
      "description": "Debug build with UndefinedBehaviorSanitizer enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/microide-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICROIDE_WARNINGS_AS_ERRORS": "OFF",
        "CMAKE_C_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=undefined"
      }
    },
    {
      "name": "microide-tsan",
      "displayName": "microide thread sanitizer",
      "description": "Debug build with ThreadSanitizer enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/microide-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICROIDE_WARNINGS_AS_ERRORS": "OFF",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
      }
    }
  ]
}
