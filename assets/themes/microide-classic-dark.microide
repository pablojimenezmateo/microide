# Preserves the previous built-in MicroIDE dark palette.
color-link default "#DAE0E8,#11151D"
color-link comment "#6B7280,#11151D"
color-link identifier "#DAE0E8,#11151D"
color-link constant "#E06C75,#11151D"
color-link constant.number "#D19A66,#11151D"
color-link constant.string "#98C379,#11151D"
color-link constant.string.char "#BDE6AD,#11151D"
color-link statement "#C678DD,#11151D"
color-link symbol "#DAE0E8,#11151D"
color-link symbol.operator "#56B6C2,#11151D"
color-link symbol.brackets "#DAE0E8,#11151D"
color-link symbol.tag "#E06C75,#11151D"
color-link preproc "#E5C07B,#11151D"
color-link type "#61AFEF,#11151D"
color-link type.keyword "#C678DD,#11151D"
color-link special "#66A4FF,#11151D"
color-link underlined "#66A4FF,#11151D"
color-link error "#E0727B,#11151D"
color-link todo "#E0BC6D,#11151D"
color-link hlsearch "#DAE0E8,#65561B"
color-link selection "#DAE0E8,#2B4F7A"
color-link statusline "#DAE0E8,#1A1F2B"
color-link tabbar "#DAE0E8,#1A1F2B"
color-link tabbar.active "#FFFFFF,#242B3A"
color-link indent-char "#3A4354,#11151D"
color-link line-number "#5F6979,#0F131B"
color-link current-line-number "#9FA9B8,#0F131B"
color-link cursor-line "#1E2533"
color-link color-column "#1E2533"
color-link match-brace "#11151D,#66A4FF"
color-link diff-added "#73A983"
color-link diff-modified "#B8A070"
color-link diff-deleted "#BC858B"
color-link diagnostic-error "#E0727B"
color-link diagnostic-warning "#E0BC6D"
color-link diagnostic-info "#66A4FF"
color-link diagnostic-hint "#7FC97F"
color-link gutter-error "#E0727B,#11151D"
color-link gutter-warning "#E0BC6D,#11151D"
color-link tab-error "#BC858B"
color-link trailingws "#BC858B"
