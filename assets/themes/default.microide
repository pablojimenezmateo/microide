# Mirrors the built-in default dark theme used when the colorscheme name is "default".
color-link default "#D7DEEA,#0F131B"
color-link comment "#8F9DB3,#0F131B"
color-link identifier "#D7DEEA,#0F131B"
color-link constant "#CBA6FF,#0F131B"
color-link constant.number "#E4B77B,#0F131B"
color-link constant.string "#B5D889,#0F131B"
color-link constant.string.char "#D6EFA9,#0F131B"
color-link statement "#FF7AA2,#0F131B"
color-link symbol "#D7DEEA,#0F131B"
color-link symbol.operator "#8ED4E6,#0F131B"
color-link symbol.brackets "#D7DEEA,#0F131B"
color-link symbol.tag "#CBA6FF,#0F131B"
color-link preproc "#EFC567,#0F131B"
color-link type "#7CC7FF,#0F131B"
color-link type.keyword "#FF7AA2,#0F131B"
color-link special "#7DDDB3,#0F131B"
color-link underlined "#7AB0FF,#0F131B"
color-link error "#FF7B86,#0F131B"
color-link todo "#E8C56D,#0F131B"
color-link hlsearch "#D7DEEA,#3A435D"
color-link selection "#D7DEEA,#294F73"
color-link statusline "#D7DEEA,#151922"
color-link tabbar "#D7DEEA,#151922"
color-link tabbar.active "#F8FBFF,#202838"
color-link indent-char "#3A4558,#0F131B"
color-link line-number "#647287,#0C1017"
color-link current-line-number "#B9C3D3,#0C1017"
color-link cursor-line "#182130"
color-link color-column "#182130"
color-link match-brace "#0F131B,#7AB0FF"
color-link diff-added "#69C07B"
color-link diff-modified "#D4A75D"
color-link diff-deleted "#E07981"
color-link diagnostic-error "#FF7B86"
color-link diagnostic-warning "#E8C56D"
color-link diagnostic-info "#7AB0FF"
color-link diagnostic-hint "#8DDF9F"
color-link gutter-error "#FF7B86,#0F131B"
color-link gutter-warning "#E8C56D,#0F131B"
color-link tab-error "#E07981"
color-link trailingws "#E07981"
